<view class="page">
  <navigation-bar title="生日提醒" back="{{false}}" color="black" background="#f7f3ef" />

  <!-- 搜索 + 过滤 -->
  <view class="toolbar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索姓名…"
        value="{{keyword}}"
        bindinput="onSearch"
      />
    </view>
    <view class="filter-chips">
      <view
        class="chip {{filterType === 'all' ? 'chip--active' : ''}}"
        bindtap="setFilter"
        data-type="all"
      ><text>全部</text></view>
      <view
        class="chip {{filterType === 'lunar' ? 'chip--active' : ''}}"
        bindtap="setFilter"
        data-type="lunar"
      ><text>农历</text></view>
      <view
        class="chip {{filterType === 'solar' ? 'chip--active' : ''}}"
        bindtap="setFilter"
        data-type="solar"
      ><text>阳历</text></view>
    </view>

    <view class="subscribe-panel">
      <view class="subscribe-panel__info">
        <text class="subscribe-panel__title">🔔 订阅生日提醒</text>
        <text class="subscribe-panel__sub">已配置模板 {{subscribeTemplateCount}} 条</text>
      </view>
      <view class="subscribe-panel__actions">
        <view class="subscribe-btn subscribe-btn--primary" bindtap="subscribeNow">
          <text>立即订阅</text>
        </view>
        <view class="subscribe-btn" bindtap="openSubscribeSettings">
          <text>消息设置</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="page__list" scroll-y type="list" enhanced show-scrollbar="{{false}}">
    <!-- 今日生日特殊区块 -->
    <view wx:if="{{todayMembers.length > 0}}" class="today-section">
      <view class="today-header">
        <text class="today-title">🎂 今日生日</text>
      </view>
      <view wx:for="{{todayMembers}}" wx:key="id" class="member-row today-member-row">
        <view class="member-avatar today-avatar">
          <text>🎂</text>
        </view>
        <view class="member-info" bindtap="onMemberTap" data-json="{{item.memberJson}}">
          <text class="member-name">{{item.name}}</text>
          <text class="member-sub">{{item.relation}} · {{item.birthdayType === 'lunar' ? '农历' : '阳历'}}{{item.birthMonth}}月{{item.birthDay}}日</text>
        </view>
        <view class="prompt-btn" bindtap="copyPrompt" data-id="{{item.id}}">
          <text>📋</text>
        </view>
      </view>
    </view>

    <!-- 按月分组 -->
    <view wx:for="{{monthSections}}" wx:key="monthKey" class="month-section">
      <view class="month-header">
        <text class="month-title">{{item.label}}</text>
        <text class="month-count">{{item.members.length}}人</text>
      </view>
      <view wx:for="{{item.members}}" wx:for-item="member" wx:key="id" class="member-row {{member.isBirthday ? 'member-row--today' : ''}}">
        <view
          class="member-avatar"
          style="background: {{member.color}}20;"
          bindtap="onMemberTap"
          data-json="{{member.memberJson}}"
        >
          <text>{{member.isBirthday ? '🎂' : (member.isUrgent ? '⚡' : '👤')}}</text>
        </view>
        <view class="member-info" bindtap="onMemberTap" data-json="{{member.memberJson}}">
          <view class="member-name-row">
            <text class="member-name">{{member.name}}</text>
            <view wx:if="{{member.isUrgent}}" class="urgent-badge">
              <text>{{member.daysUntil}}天后</text>
            </view>
          </view>
          <text class="member-sub">{{member.relation}} · {{member.birthdayType === 'lunar' ? '农历' : '阳历'}}{{member.birthMonth}}月{{member.birthDay}}日</text>
        </view>
        <view class="prompt-btn" bindtap="copyPrompt" data-id="{{member.id}}">
          <text>📋</text>
        </view>
      </view>
    </view>

  </scroll-view>
</view>

<member-modal show="{{showModal}}" memberJson="{{selectedMemberJson}}" bind:close="onModalClose" />

PORT=3000
DATABASE_PATH=./data/little-family.db
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=replace_with_server_side_secret
# 微信开放平台中已审核的网站应用；不配置时 Web 仍可使用小程序登录码。
WECHAT_OPEN_APP_ID=wx_your_website_app_id
WECHAT_OPEN_APP_SECRET=replace_with_website_app_secret
WECHAT_OPEN_REDIRECT_URI=https://family.mofada.cn/wechat-callback
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
SESSION_DAYS=30
# 仅限本地联调。生产环境必须为 false。
ALLOW_DEV_LOGIN=true

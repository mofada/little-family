<view class="page">
  <navigation-bar title="生日管理" back="{{false}}" color="black" background="#f7f3ef" />

  <scroll-view class="page__list" scroll-y type="list" enhanced show-scrollbar="{{false}}">
    <view class="sheet">
      <view class="print-masthead">
        <text class="print-masthead__name">生日</text>
        <text class="seal">生</text>
      </view>

      <view class="print-rule"></view>

      <page-state wx:if="{{loading}}" mode="loading" desc="正在加载家庭数据…" />
      <page-state
        wx:elif="{{error}}"
        mode="error"
        title="没能读到家庭数据"
        desc="{{error}}"
        actionText="重试"
        bind:action="retry"
      />

      <block wx:else>
      <view class="toolbar">
        <view class="toolbar__row">
          <view class="search-box">
            <view class="search-icon"><view class="search-icon__circle"></view><view class="search-icon__handle"></view></view>
            <input
              class="search-box__input"
              placeholder="搜索姓名或称呼"
              placeholder-class="search-placeholder"
              value="{{keyword}}"
              bindinput="onSearch"
              confirm-type="search"
            />
            <view wx:if="{{keyword}}" class="search-box__clear" bindtap="clearSearch" hover-class="tap--pressed">×</view>
          </view>
          <view wx:if="{{canAddMember}}" class="print-action print-action--primary" bindtap="startAddMember" hover-class="tap--pressed">添加</view>
        </view>

        <view class="chips">
          <view class="chip {{filterType === 'all' ? 'chip--active' : ''}}" bindtap="setFilter" data-type="all">全部</view>
          <view class="chip {{filterType === 'lunar' ? 'chip--active' : ''}}" bindtap="setFilter" data-type="lunar">农历</view>
          <view class="chip {{filterType === 'solar' ? 'chip--active' : ''}}" bindtap="setFilter" data-type="solar">阳历</view>
        </view>

        <text wx:if="{{manageHint}}" class="manage-hint">{{manageHint}}</text>
      </view>

      <view class="print-rule print-rule--tight"></view>

      <view wx:if="{{todayMembers.length > 0}}" class="today">
        <view class="today__date">
          <text class="today__day">{{dayNumber}}</text>
          <view class="today__copy">
            <text class="today__state">{{todayState}}</text>
            <text class="today__lunar">{{dateMeta}}</text>
          </view>
        </view>
        <view class="print-rule--tight"></view>
        <view class="today__body">
          <view wx:for="{{todayMembers}}" wx:key="id" class="today__person">
            <view
              class="today__row"
              bindtap="onMemberTap"
              data-json="{{item.memberJson}}"
              hover-class="row--pressed"
            >
              <view class="today__avatar"><text>{{item.avatarText}}</text></view>
              <view class="today__info">
                <text class="today__name">{{item.name}}</text>
                <text class="today__meta">{{item.todayMeta}}</text>
              </view>
              <text class="today__more">资料 ›</text>
            </view>
            <view
              class="today__wish"
              catchtap="generateWish"
              data-id="{{item.id}}"
              hover-class="tap--pressed"
            >写祝福</view>
          </view>
        </view>
      </view>

      <view
        wx:if="{{familyId && reminderStatus && (monthSections.length > 0 || noBirthdayMembers.length > 0)}}"
        class="reminder"
      >
        <view class="reminder__status">
          <view class="reminder__dot {{reminderEnabled ? 'reminder__dot--on' : ''}}"></view>
          <text>{{reminderStatus}}</text>
        </view>
        <view
          wx:if="{{reminderAction}}"
          class="print-action print-action--ghost"
          bindtap="subscribeBirthdayReminder"
          hover-class="tap--pressed"
        >{{subscribing ? '请求中' : reminderAction}}</view>
      </view>

      <page-state
        wx:if="{{emptyTitle && monthSections.length === 0 && noBirthdayMembers.length === 0}}"
        mode="empty"
        title="{{emptyTitle}}"
        desc="{{emptyDesc}}"
        actionText="{{emptyAction}}"
        bind:action="onEmptyAction"
      />

      <view wx:for="{{monthSections}}" wx:key="monthKey" class="month">
        <view class="month__head">
          <text class="month__title">{{item.label}}</text>
          <text class="month__count">共 {{item.members.length}} 人</text>
        </view>
        <view
          wx:for="{{item.members}}"
          wx:for-item="member"
          wx:key="id"
          class="print-entry"
          bindtap="onMemberTap"
          data-json="{{member.memberJson}}"
          hover-class="row--pressed"
        >
          <view class="entry__date">
            <text class="print-entry__num">{{member.nextBirthdayDay}}</text>
            <text class="entry__weekday">{{member.nextBirthdayWeekday}}</text>
          </view>
          <view class="entry__info">
            <text class="entry__name">{{member.name}}</text>
            <text class="entry__meta">{{member.relation}} · {{member.birthdayLabel}}</text>
          </view>
          <text class="entry__countdown {{member.isUrgent || member.isBirthday ? 'entry__countdown--soon' : ''}}">{{member.countdownLabel}}</text>
          <view
            wx:if="{{member.canEdit}}"
            class="print-action entry__act"
            catchtap="editMember"
            data-json="{{member.memberJson}}"
            data-can-edit="{{member.canEdit}}"
            hover-class="tap--pressed"
          >编辑</view>
          <view wx:if="{{member.isLinked}}" class="entry__me">我</view>
          <view
            wx:else
            class="print-action entry__act"
            catchtap="setAsMe"
            data-id="{{member.id}}"
            hover-class="tap--pressed"
          >{{member.selfActionLabel}}</view>
        </view>
      </view>

      <view wx:if="{{noBirthdayMembers.length > 0}}" class="pending">
        <view class="pending__head" bindtap="togglePending" hover-class="row--pressed">
          <text class="pending__num">{{noBirthdayMembers.length}}</text>
          <view class="pending__copy">
            <text class="pending__title">生日待补充</text>
            <text class="pending__hint">补上生日后，就能按月份排序</text>
          </view>
          <view class="print-action" catchtap="togglePending" hover-class="tap--pressed">{{pendingExpanded ? '收起' : '展开'}}</view>
        </view>
        <view wx:if="{{pendingExpanded}}" class="pending__body">
          <view
            wx:for="{{noBirthdayMembers}}"
            wx:key="id"
            class="print-entry"
            bindtap="onMemberTap"
            data-json="{{item.memberJson}}"
            hover-class="row--pressed"
          >
            <view class="entry__date">
              <text class="print-entry__num entry__day--empty">--</text>
              <text class="entry__weekday">待补</text>
            </view>
            <view class="entry__info">
              <text class="entry__name">{{item.name}}</text>
              <text class="entry__meta">{{item.relation || '成员'}} · 还没有记录生日</text>
            </view>
            <view
              wx:if="{{item.canEdit}}"
              class="print-action entry__act"
              catchtap="editMember"
              data-json="{{item.memberJson}}"
              data-can-edit="{{item.canEdit}}"
              hover-class="tap--pressed"
            >编辑</view>
            <view wx:if="{{item.isLinked}}" class="entry__me">我</view>
            <view
              wx:else
              class="print-action entry__act"
              catchtap="setAsMe"
              data-id="{{item.id}}"
              hover-class="tap--pressed"
            >{{item.selfActionLabel}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{monthSections.length > 0 || noBirthdayMembers.length > 0}}" class="list-footer">愿每个重要的日子，都被家人记得</view>

      <view wx:if="{{familyId}}" class="print-colophon"><text>{{familyName}} · {{memberCount}} 位家人 · 第 {{dayOfYear}} 天</text></view>
      </block>
    </view>
  </scroll-view>
</view>

<member-modal show="{{showModal}}" memberJson="{{selectedMemberJson}}" bind:close="onModalClose" />

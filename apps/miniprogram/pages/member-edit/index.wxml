<view class="page">
  <navigation-bar title="{{title}}" back="{{true}}" color="black" background="#f7f3ef" />
  <scroll-view class="page__list" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="sheet">
      <view class="print-masthead">
        <text class="print-masthead__name">成员资料</text>
        <text class="seal">录</text>
      </view>

      <view class="print-rule"></view>

      <view class="section">
        <text class="section__cap">基本资料</text>

        <view class="field">
          <text class="field__label">姓名 *</text>
          <input
            class="field__input"
            value="{{form.name}}"
            data-field="name"
            bindinput="setText"
            maxlength="30"
            placeholder="请输入姓名"
            placeholder-class="field__placeholder"
          />
        </view>

        <view class="field">
          <text class="field__label">昵称</text>
          <input
            class="field__input"
            value="{{form.nickName}}"
            data-field="nickName"
            bindinput="setText"
            maxlength="30"
            placeholder="可不填"
            placeholder-class="field__placeholder"
          />
        </view>

        <view class="field field--row">
          <text class="field__label">性别</text>
          <picker class="field__picker" mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
            <view class="field__value">{{genderOptions[genderIndex]}}<text class="field__arrow">›</text></view>
          </picker>
        </view>
      </view>

      <view class="print-rule"></view>

      <view class="section">
        <text class="section__cap">生日</text>

        <view class="switch-row">
          <text class="field__label field__label--inline">知道完整生日</text>
          <switch checked="{{hasBirthday}}" color="#b5564c" bindchange="onHasBirthdayChange" />
        </view>

        <block wx:if="{{hasBirthday}}">
          <view class="field field--row">
            <text class="field__label">历法</text>
            <picker class="field__picker" mode="selector" range="{{birthdayTypeOptions}}" value="{{birthdayTypeIndex}}" bindchange="onBirthdayTypeChange">
              <view class="field__value">{{birthdayTypeIndex === 0 ? '农历' : '阳历'}}<text class="field__arrow">›</text></view>
            </picker>
          </view>

          <view wx:if="{{form.birthdayType === 'lunar'}}" class="switch-row">
            <text class="field__label field__label--inline">闰月生日</text>
            <switch checked="{{form.isLeapMonth}}" color="#b5564c" bindchange="onLeapMonthChange" />
          </view>

          <view class="field-row">
            <view class="field field--half">
              <text class="field__label">月</text>
              <input class="field__input" type="number" value="{{form.birthMonth}}" data-field="birthMonth" bindinput="setNumber" />
            </view>
            <view class="field field--half">
              <text class="field__label">日</text>
              <input class="field__input" type="number" value="{{form.birthDay}}" data-field="birthDay" bindinput="setNumber" />
            </view>
          </view>
        </block>

        <view class="field">
          <text class="field__label">出生年份</text>
          <input
            class="field__input"
            type="number"
            value="{{form.birthYear}}"
            data-field="birthYear"
            bindinput="setNumber"
            placeholder="不知道可不填"
            placeholder-class="field__placeholder"
          />
        </view>
      </view>

      <view class="print-rule"></view>

      <view class="section">
        <text class="section__cap">亲缘关系</text>
        <text class="hint">关系可以以后补充；父母和配偶会自动形成双向图谱。</text>

        <view class="field field--row field--relation" data-field="father" bindtap="openMemberSelector" hover-class="tap-pressed">
          <text class="field__label">父亲</text>
          <view class="relation-value">
            <text class="relation-value__name">{{memberOptions[fatherIndex].name}}</text>
            <text wx:if="{{fatherIndex > 0}}" class="relation-value__meta">{{memberOptions[fatherIndex].meta}}</text>
          </view>
          <text class="field__arrow">›</text>
        </view>

        <view class="field field--row field--relation" data-field="mother" bindtap="openMemberSelector" hover-class="tap-pressed">
          <text class="field__label">母亲</text>
          <view class="relation-value">
            <text class="relation-value__name">{{memberOptions[motherIndex].name}}</text>
            <text wx:if="{{motherIndex > 0}}" class="relation-value__meta">{{memberOptions[motherIndex].meta}}</text>
          </view>
          <text class="field__arrow">›</text>
        </view>

        <view class="field field--row field--relation" data-field="spouse" bindtap="openMemberSelector" hover-class="tap-pressed">
          <text class="field__label">配偶</text>
          <view class="relation-value">
            <text class="relation-value__name">{{memberOptions[spouseIndex].name}}</text>
            <text wx:if="{{spouseIndex > 0}}" class="relation-value__meta">{{memberOptions[spouseIndex].meta}}</text>
          </view>
          <text class="field__arrow">›</text>
        </view>
      </view>

      <view class="print-rule"></view>

      <view class="footer">
        <button wx:if="{{canDelete}}" class="delete-button" loading="{{saving}}" disabled="{{saving}}" bindtap="deleteCurrentMember" hover-class="tap-pressed">删除</button>
        <button class="submit" loading="{{saving}}" disabled="{{saving}}" bindtap="submit" hover-class="tap-pressed">保存</button>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{selectorVisible}}" class="selector-layer">
    <view class="selector-mask" bindtap="closeMemberSelector" catchtouchmove="preventBubble"></view>
    <view class="selector-sheet" catchtap="preventBubble">
      <view class="selector-handle"></view>
      <view class="selector-header">
        <view class="selector-header__main">
          <text class="selector-title">{{selectorTitle}}</text>
          <text class="selector-count">共 {{memberOptions.length - 1}} 位可选成员</text>
        </view>
        <view class="selector-close" bindtap="closeMemberSelector" hover-class="tap-pressed">×</view>
      </view>

      <view class="selector-search">
        <text class="selector-search-icon">⌕</text>
        <input
          class="selector-search-input"
          value="{{selectorKeyword}}"
          bindinput="onSelectorSearch"
          placeholder="搜索姓名、昵称或出生年份"
          placeholder-class="selector-search-placeholder"
          confirm-type="search"
          focus="{{selectorVisible}}"
        />
        <view wx:if="{{selectorKeyword}}" class="selector-search-clear" bindtap="clearSelectorSearch">×</view>
      </view>

      <view class="selector-none" bindtap="clearRelationSelection">
        <view class="selector-option-body">
          <text class="selector-option-name">暂不选择</text>
          <text class="selector-option-meta">关系可以稍后补充</text>
        </view>
        <text wx:if="{{(selectorField === 'father' && fatherIndex === 0) || (selectorField === 'mother' && motherIndex === 0) || (selectorField === 'spouse' && spouseIndex === 0)}}" class="selector-check">✓</text>
      </view>

      <scroll-view class="selector-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{filteredMemberOptions.length === 0}}" class="selector-empty">
          <text class="selector-empty-title">没有找到匹配的成员</text>
          <text class="selector-empty-hint">换个姓名、称呼或年份试试</text>
        </view>
        <view
          wx:for="{{filteredMemberOptions}}"
          wx:key="id"
          class="selector-option"
          data-id="{{item.id}}"
          bindtap="selectMember"
        >
          <view class="selector-avatar">{{item.avatar}}</view>
          <view class="selector-option-body">
            <text class="selector-option-name">{{item.name}}</text>
            <text class="selector-option-meta">{{item.meta}}</text>
          </view>
          <text wx:if="{{(selectorField === 'father' && memberOptions[fatherIndex].id === item.id) || (selectorField === 'mother' && memberOptions[motherIndex].id === item.id) || (selectorField === 'spouse' && memberOptions[spouseIndex].id === item.id)}}" class="selector-check">✓</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>

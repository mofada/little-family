<view class="page">
  <navigation-bar title="{{title}}" back="{{true}}" color="black" background="#f7f3ef" />
  <scroll-view class="content" scroll-y>
    <view class="card">
      <text class="section-title">基本资料</text>
      <text class="label">姓名 *</text>
      <input class="input" value="{{form.name}}" data-field="name" bindinput="setText" maxlength="30" placeholder="请输入姓名" />
      <text class="label">昵称</text>
      <input class="input" value="{{form.nickName}}" data-field="nickName" bindinput="setText" maxlength="30" placeholder="可不填" />
      <view class="field"><text class="label">性别</text><picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange"><view class="picker">{{genderOptions[genderIndex]}} ›</view></picker></view>
    </view>

    <view class="card">
      <text class="section-title">生日</text>
      <view class="switch-row"><text class="label">知道完整生日</text><switch checked="{{hasBirthday}}" color="#d4756a" bindchange="onHasBirthdayChange" /></view>
      <block wx:if="{{hasBirthday}}">
      <text class="label">历法</text>
      <picker mode="selector" range="{{birthdayTypeOptions}}" value="{{birthdayTypeIndex}}" bindchange="onBirthdayTypeChange"><view class="picker">{{birthdayTypeIndex === 0 ? '农历' : '阳历'}} ›</view></picker>
      <view wx:if="{{form.birthdayType === 'lunar'}}" class="switch-row">
        <text class="label">闰月生日</text>
        <switch checked="{{form.isLeapMonth}}" color="#d4756a" bindchange="onLeapMonthChange" />
      </view>
      <view class="three-cols">
        <view class="field"><text class="label">月</text><input class="input" type="number" value="{{form.birthMonth}}" data-field="birthMonth" bindinput="setNumber" /></view>
        <view class="field"><text class="label">日</text><input class="input" type="number" value="{{form.birthDay}}" data-field="birthDay" bindinput="setNumber" /></view>
      </view>
      </block>
      <text class="label">出生年份</text>
      <input class="input" type="number" value="{{form.birthYear}}" data-field="birthYear" bindinput="setNumber" placeholder="不知道可不填" />
    </view>

    <view class="card">
      <text class="section-title">亲缘关系</text>
      <text class="hint">关系可以以后补充；父母和配偶会自动形成双向图谱。</text>
      <text class="label">父亲</text>
      <view class="picker relation-picker" data-field="father" bindtap="openMemberSelector">
        <view class="relation-value">
          <text>{{memberOptions[fatherIndex].name}}</text>
          <text wx:if="{{fatherIndex > 0}}" class="relation-meta">{{memberOptions[fatherIndex].meta}}</text>
        </view>
        <text class="picker-arrow">›</text>
      </view>
      <text class="label">母亲</text>
      <view class="picker relation-picker" data-field="mother" bindtap="openMemberSelector">
        <view class="relation-value">
          <text>{{memberOptions[motherIndex].name}}</text>
          <text wx:if="{{motherIndex > 0}}" class="relation-meta">{{memberOptions[motherIndex].meta}}</text>
        </view>
        <text class="picker-arrow">›</text>
      </view>
      <text class="label">配偶</text>
      <view class="picker relation-picker" data-field="spouse" bindtap="openMemberSelector">
        <view class="relation-value">
          <text>{{memberOptions[spouseIndex].name}}</text>
          <text wx:if="{{spouseIndex > 0}}" class="relation-meta">{{memberOptions[spouseIndex].meta}}</text>
        </view>
        <text class="picker-arrow">›</text>
      </view>
    </view>

    <view class="footer">
    <button wx:if="{{canDelete}}" class="delete-button" loading="{{saving}}" disabled="{{saving}}" bindtap="deleteCurrentMember">删除成员</button>
    <button class="submit" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">保存成员</button>
    </view>
  </scroll-view>

  <view wx:if="{{selectorVisible}}" class="selector-mask" bindtap="closeMemberSelector" catchtouchmove="preventBubble">
    <view class="selector-sheet" catchtap="preventBubble">
      <view class="selector-handle"></view>
      <view class="selector-header">
        <view>
          <text class="selector-title">{{selectorTitle}}</text>
          <text class="selector-count">共 {{memberOptions.length - 1}} 位可选成员</text>
        </view>
        <view class="selector-close" bindtap="closeMemberSelector">×</view>
      </view>

      <view class="selector-search">
        <text class="selector-search-icon">⌕</text>
        <input
          class="selector-search-input"
          value="{{selectorKeyword}}"
          bindinput="onSelectorSearch"
          placeholder="搜索姓名、昵称或出生年份"
          placeholder-class="selector-search-placeholder"
          confirm-type="search"
          focus="{{selectorVisible}}"
        />
        <view wx:if="{{selectorKeyword}}" class="selector-search-clear" bindtap="clearSelectorSearch">×</view>
      </view>

      <view class="selector-none" bindtap="clearRelationSelection">
        <view>
          <text class="selector-option-name">暂不选择</text>
          <text class="selector-option-meta">关系可以稍后补充</text>
        </view>
        <text wx:if="{{(selectorField === 'father' && fatherIndex === 0) || (selectorField === 'mother' && motherIndex === 0) || (selectorField === 'spouse' && spouseIndex === 0)}}" class="selector-check">✓</text>
      </view>

      <scroll-view class="selector-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{filteredMemberOptions.length === 0}}" class="selector-empty">
          <text class="selector-empty-title">没有找到匹配的成员</text>
          <text class="selector-empty-hint">换个姓名、称呼或年份试试</text>
        </view>
        <view
          wx:for="{{filteredMemberOptions}}"
          wx:key="id"
          class="selector-option"
          data-id="{{item.id}}"
          bindtap="selectMember"
        >
          <view class="selector-avatar">{{item.avatar}}</view>
          <view class="selector-option-body">
            <text class="selector-option-name">{{item.name}}</text>
            <text class="selector-option-meta">{{item.meta}}</text>
          </view>
          <text wx:if="{{(selectorField === 'father' && memberOptions[fatherIndex].id === item.id) || (selectorField === 'mother' && memberOptions[motherIndex].id === item.id) || (selectorField === 'spouse' && memberOptions[spouseIndex].id === item.id)}}" class="selector-check">✓</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>

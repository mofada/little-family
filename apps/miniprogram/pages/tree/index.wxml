<view class="page">
  <navigation-bar title="族谱树" back="{{false}}" color="black" background="#f7f3ef" />

  <view class="toolbar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索成员姓名、称呼、家族…"
        value="{{keyword}}"
        bindinput="onSearch"
      />
    </view>
    <view class="toolbar-foot">
      <text class="toolbar-stat">当前展示 {{visibleCount}} / {{totalCount}} 人</text>
      <view class="toolbar-action" bindtap="resetFamilyFilters">
        <text>重置筛选</text>
      </view>
    </view>
  </view>

  <scroll-view class="family-filter" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="family-filter-inner">
      <view
        wx:for="{{familyFilters}}"
        wx:key="name"
        class="family-chip {{item.active ? 'family-chip--active' : ''}}"
        style="{{item.active ? 'background:' + item.color + '18; border-color:' + item.color + '; color:' + item.color : ''}}"
        bindtap="toggleFamily"
        data-name="{{item.name}}"
      >
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <scroll-view class="page__list" scroll-x scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{nodes.length === 0}}" class="empty-state">
      <text class="empty-state__emoji">🧭</text>
      <text class="empty-state__title">没有找到匹配成员</text>
      <text class="empty-state__sub">尝试清空搜索词或重置家族筛选</text>
    </view>

    <view wx:else class="graph-canvas" style="width: {{canvasWidth}}rpx; height: {{canvasHeight}}rpx;">
      <view
        wx:for="{{edgeSegments}}"
        wx:key="index"
        class="edge-segment"
        style="left: {{item.left}}rpx; top: {{item.top}}rpx; width: {{item.width}}rpx; height: {{item.height}}rpx; background: {{item.color}}; opacity: {{item.opacity}};"
      />

      <view
        wx:for="{{nodes}}"
        wx:key="id"
        class="node-card {{item.isMe ? 'node-card--me' : ''}}"
        style="left: {{item.left}}rpx; top: {{item.top}}rpx; border-color: {{item.color}}55;"
        bindtap="onCardTap"
        data-json="{{item.memberJson}}"
      >
        <view class="node-main">
          <view class="node-avatar" style="background: {{item.color}}1f;">
            <text>{{item.avatarEmoji}}</text>
          </view>
          <view class="node-info">
            <view class="node-name-row">
              <text class="node-name">{{item.name}}</text>
              <view wx:if="{{item.isMe}}" class="me-badge"><text>我</text></view>
            </view>
            <text class="node-sub">{{item.relation}}</text>
          </view>
        </view>
        <view class="node-foot">
          <text class="family-tag" style="background: {{item.color}}15; color: {{item.color}};">{{item.familyName}}</text>
          <text class="age-tag">{{item.age !== null ? item.age + '岁' : '未知'}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

<member-modal show="{{showModal}}" memberJson="{{selectedMemberJson}}" bind:close="onModalClose" />

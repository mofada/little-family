<view class="page">
  <navigation-bar title="族谱" back="{{false}}" color="black" background="#f7f3ef" />

  <scroll-view class="page__list" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="sheet">
      <view class="print-masthead">
        <text class="print-masthead__name">族谱</text>
        <text class="seal">谱</text>
      </view>

      <view class="print-rule"></view>

      <view class="toolbar">
        <view class="toolbar__row">
          <view class="search-box">
            <view class="search-icon">
              <view class="search-icon__circle"></view>
              <view class="search-icon__handle"></view>
            </view>
            <input
              class="search-box__input"
              placeholder="输入姓名、昵称或称呼"
              placeholder-class="search-placeholder"
              value="{{keyword}}"
              bindinput="onSearch"
              confirm-type="search"
            />
            <view wx:if="{{keyword}}" class="search-box__clear" bindtap="onClearSearch" hover-class="tap-pressed"><text>×</text></view>
          </view>
          <view
            wx:if="{{focus}}"
            class="print-action"
            bindtap="onBackToMe"
            hover-class="tap-pressed"
          >回到我</view>
        </view>
        <text class="toolbar__meta">已记录 {{totalCount}} 位家人 · {{generationCount}} 代</text>

        <view wx:if="{{keyword}}" class="search-results">
          <view wx:if="{{searchResults.length === 0}}" class="search-empty"><text>没有找到匹配的家人</text></view>
          <view
            wx:for="{{searchResults}}"
            wx:key="id"
            class="search-result print-entry"
            data-id="{{item.id}}"
            bindtap="onFocusMember"
            hover-class="row--pressed"
          >
            <view class="search-result__body">
              <text class="search-result__name">{{item.name}}</text>
              <text class="search-result__meta">{{item.relation}} · {{item.meta}}</text>
            </view>
            <view class="chevron"></view>
          </view>
        </view>
      </view>

      <block wx:if="{{focus}}">
        <!-- 中心人物：整行打开资料，右侧只留一个记号 -->
        <view class="focus" bindtap="onOpenFocusModal" hover-class="row--pressed">
          <view class="focus__body">
            <view class="focus__name-line">
              <text class="focus__name">{{focus.name}}</text>
              <text wx:if="{{focus.isMe}}" class="me-mark">我</text>
            </view>
            <text class="focus__meta">{{focus.relation}} · {{focus.ageLabel}}</text>
          </view>
          <text class="focus__more">资料 ›</text>
        </view>

        <!-- 三代账页：左栏辈分，右栏人名 -->
        <view class="ledger">
          <view class="ledger__row">
            <text class="ledger__label">上一代</text>
            <view wx:if="{{parents.length}}" class="ledger__people">
              <view
                wx:for="{{parents}}"
                wx:key="id"
                class="person"
                data-id="{{item.id}}"
                bindtap="onFocusMember"
                hover-class="tap-pressed"
              >
                <text class="person__name">{{item.name}}</text>
                <text class="person__kin">{{item.relation}}</text>
                <text wx:if="{{item.isMe}}" class="me-mark">我</text>
              </view>
            </view>
            <text wx:else class="ledger__empty">暂无</text>
          </view>

          <view class="ledger__row">
            <text class="ledger__label">同代</text>
            <view class="ledger__people">
              <view
                class="person"
                data-id="{{focus.id}}"
                bindtap="onFocusMember"
                hover-class="tap-pressed"
              >
                <text class="person__name">{{focus.name}}</text>
                <text wx:if="{{focus.isMe}}" class="me-mark">我</text>
              </view>
              <view
                wx:if="{{spouse}}"
                class="person"
                data-id="{{spouse.id}}"
                bindtap="onFocusMember"
                hover-class="tap-pressed"
              >
                <text class="person__name">{{spouse.name}}</text>
                <text class="person__kin">{{spouse.relation}}</text>
                <text wx:if="{{spouse.isMe}}" class="me-mark">我</text>
              </view>
              <view
                wx:for="{{siblings}}"
                wx:key="id"
                class="person"
                data-id="{{item.id}}"
                bindtap="onFocusMember"
                hover-class="tap-pressed"
              >
                <text class="person__name">{{item.name}}</text>
                <text class="person__kin">{{item.relation}}</text>
                <text wx:if="{{item.isMe}}" class="me-mark">我</text>
              </view>
            </view>
          </view>

          <view class="ledger__row">
            <text class="ledger__label">下一代</text>
            <view wx:if="{{children.length}}" class="ledger__people">
              <view
                wx:for="{{children}}"
                wx:key="id"
                class="person"
                data-id="{{item.id}}"
                bindtap="onFocusMember"
                hover-class="tap-pressed"
              >
                <text class="person__name">{{item.name}}</text>
                <text class="person__kin">{{item.relation}}</text>
                <text wx:if="{{item.isMe}}" class="me-mark">我</text>
              </view>
            </view>
            <text wx:else class="ledger__empty">暂无</text>
          </view>
        </view>

        <view class="browse">
          <view class="print-rule"></view>
          <view class="browse__head">
            <text class="browse__title">按辈分浏览</text>
            <text class="browse__hint">点名字换中心</text>
          </view>

          <scroll-view class="generation-tabs" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="generation-tabs__track">
              <view
                wx:for="{{generationTabs}}"
                wx:key="generation"
                class="chip {{item.active ? 'chip--active' : ''}}"
                data-generation="{{item.generation}}"
                bindtap="onSelectGeneration"
                hover-class="tap-pressed"
              >
                <text>{{item.label}}</text>
                <text class="chip__count">{{item.count}}人</text>
              </view>
            </view>
          </scroll-view>

          <view class="member-list">
            <view
              wx:for="{{generationMembers}}"
              wx:key="id"
              class="member-entry print-entry {{item.id === focus.id ? 'member-entry--active' : ''}}"
              data-id="{{item.id}}"
              bindtap="onFocusMember"
              hover-class="row--pressed"
            >
              <text class="member-entry__num">{{index + 1}}</text>
              <view class="member-entry__body">
                <view class="member-entry__name-line">
                  <text class="member-entry__name">{{item.name}}</text>
                  <text wx:if="{{item.isMe}}" class="me-mark">我</text>
                </view>
                <view class="member-entry__meta">
                  <text class="member-entry__relation">{{item.relation}}</text>
                  <text class="member-entry__age"> · {{item.ageLabel}}</text>
                </view>
              </view>
              <view class="chevron"></view>
            </view>
          </view>
        </view>
      </block>

      <view wx:else class="empty-state">
        <text class="empty-state__title">族谱里还没有成员</text>
        <text class="empty-state__subtitle">添加家人后，就能从这里浏览家庭关系</text>
      </view>

      <view wx:if="{{familyName}}" class="print-colophon">
        <text>{{familyName}} · {{memberCount}} 位家人 · 第 {{dayOfYear}} 天</text>
      </view>
    </view>
  </scroll-view>
</view>

<member-modal show="{{showModal}}" memberJson="{{selectedMemberJson}}" bind:close="onModalClose" />

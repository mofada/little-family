<view class="page">
<navigation-bar title="家族图谱" back="{{false}}" color="black" background="#f7f3ef" />

<scroll-view class="page__list" scroll-y type="list" enhanced show-scrollbar="{{false}}">

  <view wx:if="{{loading}}" class="empty-today">
    <text class="empty-emoji">⏳</text>
    <text class="empty-text">正在加载家庭数据…</text>
  </view>

  <view wx:if="{{needsFamily}}" class="section">
    <view class="empty-today">
      <text class="empty-emoji">🏡</text>
      <text class="section-title">创建你的第一个家庭</text>
      <text class="empty-text">家庭数据仅对受邀成员可见</text>
      <view class="copy-btn" bindtap="goFamilyManage"><text>开始设置</text></view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view wx:if="{{!loading && !needsFamily}}" class="stats-grid">
    <view class="stat-card" bindtap="goPage" data-path="/pages/tree/index" hover-class="stat-card--pressed">
      <text class="stat-value">{{statsTotal}}</text>
      <text class="stat-label">成员总数</text>
    </view>
    <view class="stat-card" bindtap="goPage" data-path="/pages/tree/index" hover-class="stat-card--pressed">
      <text class="stat-value">{{statsFamilies}}</text>
      <text class="stat-label">家族分支</text>
    </view>
    <view class="stat-card stat-card--accent" bindtap="goPage" data-path="/pages/birthday/index" hover-class="stat-card--pressed">
      <text class="stat-value">{{statsTodayCount}}</text>
      <text class="stat-label">今日生日</text>
    </view>
    <view class="stat-card" bindtap="goPage" data-path="/pages/birthday/index" hover-class="stat-card--pressed">
      <text class="stat-value">{{statsUpcoming}}</text>
      <text class="stat-label">近30天</text>
    </view>
  </view>

  <!-- 今日生日 -->
  <view wx:if="{{todayBirthdays.length > 0}}" class="section">
    <view class="section-header">
      <text class="section-title">🎂 今日生日</text>
    </view>
    <view wx:for="{{todayBirthdays}}" wx:key="id" class="birthday-row today-row">
      <view class="birthday-avatar" style="background: {{item.color}}20;">
        <text class="birthday-avatar-emoji">🎂</text>
      </view>
      <view class="birthday-info">
        <text class="birthday-name">{{item.name}}</text>
        <text class="birthday-meta">{{item.relation}} · {{item.birthdayType === 'lunar' ? (item.isLeapMonth ? '农历闰' : '农历') : '阳历'}}{{item.birthMonth}}月{{item.birthDay}}日</text>
      </view>
      <view bindtap="copyTodayPrompt" data-index="{{index}}" class="copy-btn">
        <text>📋 Prompt</text>
      </view>
    </view>
  </view>

  <!-- 无今日生日 -->
  <view wx:else class="section">
    <view class="empty-today">
      <text class="empty-emoji">📅</text>
      <text class="empty-text">今天暂无生日</text>
    </view>
  </view>

  <!-- 即将过生日 -->
  <view wx:if="{{upcomingBirthdays.length > 0}}" class="section">
    <view class="section-header">
      <text class="section-title">🔔 即将过生日</text>
      <text class="section-sub">未来30天</text>
    </view>
    <view wx:for="{{upcomingBirthdays}}" wx:key="id" class="birthday-row">
      <view class="birthday-avatar" style="background: {{item.color}}20;">
        <text class="birthday-avatar-emoji">{{item.isUrgent ? '⚡' : '👤'}}</text>
      </view>
      <view class="birthday-info">
        <text class="birthday-name">{{item.name}}</text>
        <text class="birthday-meta">{{item.relation}} · {{item.birthdayType === 'lunar' ? (item.isLeapMonth ? '农历闰' : '农历') : '阳历'}}{{item.birthMonth}}月{{item.birthDay}}日</text>
      </view>
      <view class="days-badge {{item.isUrgent ? 'days-badge--urgent' : ''}}">
        <text>{{item.daysUntil}}天后</text>
      </view>
    </view>
  </view>

  <!-- 快速导航 -->
  <view class="section nav-section">
    <view class="section-header">
      <text class="section-title">🧭 快速导航</text>
    </view>
    <view class="nav-grid">
      <view class="nav-item" bindtap="goPage" data-path="/pages/tree/index">
        <text class="nav-icon">🌳</text>
        <text class="nav-label">族谱树</text>
      </view>
      <view class="nav-item" bindtap="goPage" data-path="/pages/birthday/index">
        <text class="nav-icon">🎂</text>
        <text class="nav-label">生日</text>
      </view>
      <view class="nav-item" bindtap="goPage" data-path="/pages/timeline/index">
        <text class="nav-icon">📅</text>
        <text class="nav-label">时间轴</text>
      </view>
      <view class="nav-item" bindtap="goPage" data-path="/pages/profile/index">
        <text class="nav-icon">👤</text>
        <text class="nav-label">我的</text>
      </view>
    </view>
  </view>

</scroll-view>

<member-modal show="{{showModal}}" memberJson="{{selectedMemberJson}}" bind:close="onModalClose" />
</view>

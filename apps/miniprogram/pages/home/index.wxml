<view class="page">
  <navigation-bar title="小家记" back="{{false}}" color="black" background="#f7f3ef" />

  <scroll-view class="page__list" scroll-y type="list" enhanced show-scrollbar="{{false}}">

    <view wx:if="{{loading}}" class="state">
      <text class="state__desc">正在加载家庭数据…</text>
    </view>

    <view wx:elif="{{error}}" class="state">
      <text class="state__title">没能读到家庭数据</text>
      <text class="state__desc">{{error}}</text>
      <view class="state__button" bindtap="retry" hover-class="tap-pressed">重试</view>
    </view>

    <view wx:elif="{{needsFamily}}" class="state">
      <text class="state__title">还没有家庭</text>
      <text class="state__desc">设置完成后，家人的生日会显示在这里</text>
      <view class="state__button" bindtap="goFamilyManage" hover-class="tap-pressed">开始设置</view>
    </view>

    <block wx:else>
      <view class="sheet">
      <view class="masthead">
        <text class="masthead__name">{{familyName || '小家记'}}</text>
        <text class="seal">家</text>
      </view>

      <view class="rule"></view>

      <view class="dateline">
        <view class="dateline__left">
          <text class="dateline__month">{{monthLabel}}</text>
          <text class="dateline__day {{todayEmpty ? '' : 'dateline__day--busy'}}">{{dayNumber}}</text>
          <text class="dateline__weekday">{{weekdayLabel}}</text>
        </view>
        <view class="dateline__right">
          <text class="dateline__lunar">{{lunarLabel}}</text>
          <text class="dateline__state {{todayEmpty ? 'dateline__state--quiet' : 'dateline__state--busy'}}">{{todayState}}</text>
        </view>
      </view>

      <view wx:if="{{!todayEmpty}}" class="today-list">
        <view wx:for="{{todayPeople}}" wx:key="id" class="today-item">
          <view
            class="today-item__row"
            bindtap="onMemberTap"
            data-json="{{item.memberJson}}"
            hover-class="row--pressed"
          >
            <view class="today-item__avatar"><text>{{item.avatarText}}</text></view>
            <view class="today-item__info">
              <text class="today-item__name">{{item.name}}</text>
              <text class="today-item__meta">{{item.meta}}</text>
            </view>
            <text class="today-item__more">资料 ›</text>
          </view>
          <view
            class="wish"
            catchtap="generateWish"
            data-id="{{item.id}}"
            hover-class="tap-pressed"
          >给 {{item.name}} 写祝福</view>
        </view>
      </view>

      <view class="rule"></view>

      <view class="ledger">
        <view class="ledger__head">
          <text class="ledger__title">接下来 30 天</text>
          <text wx:if="{{upcomingCount > 0}}" class="ledger__count">还有 {{upcomingCount}} 位</text>
        </view>

        <view
          wx:for="{{upcoming}}"
          wx:key="id"
          class="entry"
          bindtap="onMemberTap"
          data-json="{{item.memberJson}}"
          hover-class="row--pressed"
        >
          <view class="entry__date">
            <text class="entry__day">{{item.day}}</text>
            <text class="entry__month">{{item.month}}</text>
          </view>
          <view class="entry__info">
            <text class="entry__name">{{item.name}}</text>
            <text class="entry__meta">{{item.meta}}</text>
          </view>
          <text class="entry__badge {{item.isUrgent ? 'entry__badge--soon' : ''}}">{{item.badge}}</text>
        </view>

        <view wx:if="{{upcomingCount === 0}}" class="entry entry--empty">
          <text>接下来 30 天没有生日</text>
        </view>
      </view>

      <block wx:if="{{reminderConfigured || missingCount > 0}}">
        <view class="rule"></view>

        <view wx:if="{{reminderConfigured}}" class="notice">
          <view class="notice__main">
            <text class="notice__label">生日提醒</text>
            <text class="notice__detail">{{reminderEnabled ? '已开启 · 每天 8:00 推送' : '尚未开启'}}</text>
          </view>
          <view
            wx:if="{{reminderEnabled}}"
            class="action action--ghost"
            bindtap="goBirthday"
            hover-class="tap-pressed"
          >查看</view>
          <view
            wx:else
            class="action action--primary"
            bindtap="goBirthday"
            hover-class="tap-pressed"
          >开启提醒</view>
        </view>

        <view wx:if="{{missingCount > 0}}" class="notice">
          <view class="notice__main">
            <text class="notice__label">还有 {{missingCount}} 位没填生日</text>
            <text class="notice__detail">补上之后才会出现在这里</text>
          </view>
          <view
            wx:if="{{canManage}}"
            class="action"
            bindtap="goBirthday"
            hover-class="tap-pressed"
          >去补充</view>
          <text wx:else class="notice__plain">让维护者补充</text>
        </view>
      </block>

      <view class="rule rule--footer"></view>

      <view class="action action--wide" bindtap="goBirthday" hover-class="tap-pressed">
        <text class="action__label">查看全部生日</text>
        <text class="action__meta">{{monthRemaining > 0 ? '本月还有 ' + monthRemaining + ' 位' : ''}}</text>
      </view>

      <view class="colophon"><text>{{colophon}}</text></view>
      </view>
    </block>

  </scroll-view>

  <member-modal show="{{showModal}}" memberJson="{{selectedMemberJson}}" bind:close="onModalClose" />
</view>

<view class="page">
  <navigation-bar title="我的" back="{{false}}" color="black" background="#f7f3ef" />

  <scroll-view class="page__list" scroll-y type="list" enhanced show-scrollbar="{{false}}">
    <view class="sheet">
      <view class="print-masthead">
        <text class="print-masthead__name">我的</text>
        <text class="seal">我</text>
      </view>

      <view class="print-rule"></view>

      <page-state wx:if="{{loading}}" mode="loading" desc="正在加载家庭数据…" />
      <page-state
        wx:elif="{{error}}"
        mode="error"
        title="没能读到家庭数据"
        desc="{{error}}"
        actionText="重试"
        bind:action="retry"
      />

      <block wx:else>
        <block wx:if="{{me}}">
          <!-- 身份：不使用卡片，直接排成印刷页的页首 -->
          <view class="head">
            <view class="head__row">
              <text class="head__name">{{me.name}}</text>
              <view class="head__me"><text>我</text></view>
            </view>
            <text class="head__meta">{{me.meta}}</text>
            <view class="head__birthday">
              <text class="head__date">{{me.birthdayLabel}}</text>
              <text wx:if="{{me.countdownLabel}}" class="head__days {{me.isBirthdayToday ? 'head__days--today' : ''}}">{{me.countdownLabel}}</text>
            </view>
          </view>

          <view class="print-rule print-rule--tight"></view>

          <!-- 直系家庭：按关系分行，横向铺满 -->
          <view class="kin">
            <text class="section-title">直系家庭</text>
            <view wx:if="{{kinGroups.length > 0}}" class="kin__list">
              <view wx:for="{{kinGroups}}" wx:key="key" class="kin__row">
                <text class="kin__label">{{item.label}}</text>
                <view class="kin__people">
                  <view
                    wx:for="{{item.members}}"
                    wx:for-item="person"
                    wx:key="id"
                    class="kin__person"
                    bindtap="onMemberTap"
                    data-json="{{person.memberJson}}"
                    hover-class="chip--pressed"
                  >{{person.name}}</view>
                </view>
              </view>
            </view>
            <text wx:else class="kin__empty">还没有录入直系亲属</text>
          </view>
        </block>

        <page-state
          wx:else
          mode="empty"
          title="{{emptyTitle}}"
          desc="{{emptyDesc}}"
          actionText="{{emptyAction}}"
          bind:action="onEmptyAction"
        />

        <!-- 设置：细线行，右侧是值或箭头 -->
        <view class="settings">
          <text class="section-title">设置</text>
          <view class="settings__list">
            <view class="settings__row" bindtap="manageFamily" hover-class="row--pressed">
              <view class="settings__main">
                <view wx:if="{{hasNewJoins}}" class="settings__dot"></view>
                <text class="settings__label">家庭与成员管理</text>
              </view>
              <view class="settings__value">
                <text class="settings__arrow">›</text>
              </view>
            </view>

            <view
              wx:if="{{families.length > 1}}"
              class="settings__row"
              bindtap="openFamilySwitcher"
              hover-class="row--pressed"
            >
              <text class="settings__label">切换家庭</text>
              <view class="settings__value">
                <text class="settings__hint">{{familyName}}</text>
                <text class="settings__arrow">›</text>
              </view>
            </view>

            <view
              wx:if="{{me && familyId}}"
              class="settings__row"
              bindtap="refreshKinship"
              hover-class="row--pressed"
            >
              <text class="settings__label">刷新称呼</text>
              <view class="settings__value">
                <text wx:if="{{refreshingKinship}}" class="settings__hint">刷新中</text>
                <text class="settings__arrow">›</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{hasFamily}}" class="print-colophon"><text>{{familyName}} · {{memberCount}} 位家人 · 第 {{dayOfYear}} 天</text></view>
      </block>
    </view>
  </scroll-view>

  <member-modal show="{{showModal}}" memberJson="{{selectedMemberJson}}" bind:close="onModalClose" />
</view>

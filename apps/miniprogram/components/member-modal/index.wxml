<view wx:if="{{show}}" class="modal-mask" bindtap="onMaskTap">
  <view class="modal-sheet" catchtap="onContentTap">
    <view class="modal-grabber"></view>
    <view class="modal-close" bindtap="onClose" hover-class="tap-pressed"><text>✕</text></view>

    <view class="member-head">
      <view class="member-avatar" style="background: {{color}}1f;">
        <text>{{avatarText}}</text>
      </view>
      <view class="member-head__info">
        <view class="member-name-row">
          <text class="member-name">{{member.name}}</text>
          <text wx:if="{{isMe}}" class="member-me">我</text>
        </view>
        <text class="member-meta">{{metaLine}}</text>
        <text wx:if="{{member.nickName}}" class="member-nick">「{{member.nickName}}」</text>
      </view>
    </view>

    <scroll-view class="modal-body" scroll-y type="list">
      <view class="info-row">
        <text class="info-label">生日</text>
        <view class="info-value-wrap">
          <text class="info-value">{{birthdayText}}</text>
          <text wx:if="{{isBirthday}}" class="badge badge--today">今天</text>
          <text wx:elif="{{daysUntil !== null && daysUntil <= 30}}" class="badge">还剩 {{daysUntil}} 天</text>
        </view>
      </view>

      <view class="info-row">
        <text class="info-label">性别</text>
        <text class="info-value">{{genderText}}</text>
      </view>

      <view wx:if="{{hasRelatives}}" class="relation-block">
        <text class="info-label">家人</text>
        <view class="relation-groups">
          <view wx:if="{{parents.length > 0}}" class="relation-group">
            <text class="relation-group__label">父母</text>
            <view class="relation-chips">
              <view wx:for="{{parents}}" wx:key="id" class="chip">{{item.name}}</view>
            </view>
          </view>

          <view wx:if="{{spouse}}" class="relation-group">
            <text class="relation-group__label">配偶</text>
            <view class="relation-chips">
              <view class="chip">{{spouse.name}}</view>
            </view>
          </view>

          <view wx:if="{{children.length > 0}}" class="relation-group">
            <text class="relation-group__label">子女</text>
            <view class="relation-chips">
              <view wx:for="{{children}}" wx:key="id" class="chip">{{item.name}}</view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{isBirthday || canEdit}}" class="modal-actions">
        <view
          wx:if="{{isBirthday}}"
          class="btn btn--primary"
          bindtap="generateWish"
          hover-class="tap-pressed"
        >{{generating ? '正在生成…' : '生成生日祝福'}}</view>
        <view
          wx:if="{{canEdit}}"
          class="btn btn--secondary"
          bindtap="editMember"
          hover-class="tap-pressed"
        >编辑资料</view>
      </view>
    </scroll-view>
  </view>
</view>
